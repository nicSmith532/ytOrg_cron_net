# ── ytOrg3 (.NET) Connection ───────────────────────────────────────────────────
# Local or Railway private networking URL (no trailing slash)
YT_APP_URL=http://ytappv3.railway.internal:8080

# Must match CRON_SECRET in ytOrg3's environment
CRON_SECRET=DylanNasHaydenKimbelryRylieMya

# ── Database (for zerror_log_cron logging) ──────────────────────────────────
# Either DATABASE_URL or individual DB_* settings:
DATABASE_URL=postgresql://postgres:password@postgres.railway.internal:5432/railway
DB_HOST=postgres.railway.internal
DB_PORT=5432
DB_NAME=railway
DB_USER=postgres
DB_PASSWORD=
